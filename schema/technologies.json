  "short_range": "Bluetooth, LoRa and other short-range / IoT links",
  "drone": "drone video, control and identification links",
  "voice": "land-mobile and walkie-talkie voice",
  "aviation": "aeronautical radio (SSR, ADS-B, DME, radar altimeters)",
