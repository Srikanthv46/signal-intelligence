# si_embed_files(<out.cpp> <file>...) — compile text files into the library:
#   const char* si::embedded_file(const std::string& basename)  (nullptr if absent)
function(si_embed_files out)
  set(body "// generated by cmake/EmbedFiles.cmake: do not edit\n#include <cstring>\n#include <string>\n")
  string(APPEND body "namespace si {\nnamespace {\n")
  set(table "")
  set(i 0)
  foreach(f ${ARGN})
    file(READ ${f} content HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," content "${content}")
    get_filename_component(name ${f} NAME)
    string(APPEND body "const char f${i}[] = {${content}0x00};\n")
    string(APPEND table "    {\"${name}\", f${i}},\n")
    math(EXPR i "${i}+1")
  endforeach()
  string(APPEND body "struct Entry { const char* name; const char* data; };\nconst Entry table[] = {\n${table}};\n}  // namespace\n")
  string(APPEND body "const char* embedded_file(const std::string& name) {\n  for (const auto& e : table)\n    if (name == e.name) return e.data;\n  return nullptr;\n}\n}  // namespace si\n")
  file(WRITE ${out}.tmp "${body}")
  configure_file(${out}.tmp ${out} COPYONLY)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${ARGN})
endfunction()
